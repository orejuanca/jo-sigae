generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Student {
  id              String          @id @default(cuid())
  cedula          String          @unique
  fechaNacimiento String?
  apellidos       String
  nombres         String
  pais            String          @default("VENEZUELA")
  estado          String          @default("")
  municipio       String          @default("")
  seccion         String          @default("")
  plan            String          @default("vigente")
  rawData         String          @default("{}")
  certDraft       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  boletaExtras    BoletaExtra[]
  boletaNotas     BoletaNota[]
  certifications  Certification[]

  @@index([cedula])
  @@index([apellidos])
  @@index([nombres])
}

model Certification {
  id           String   @id @default(cuid())
  studentId    String
  tipo         String   @default("certificacion")
  fechaEmision DateTime @default(now())
  datos        String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  numero       String   @default("")
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tipo])
}

model BoletaNota {
  id          String   @id @default(cuid())
  studentId   String
  anioEscolar String
  grado       String
  seccion     String
  materia     String
  lapso1      String?
  lapso2      String?
  lapso3      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revision    String?
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, anioEscolar, grado, seccion, materia])
  @@index([studentId])
  @@index([anioEscolar, grado, seccion])
}

model BoletaExtra {
  id                String   @id @default(cuid())
  studentId         String
  anioEscolar       String
  grado             String
  seccion           String
  grupo1            String?
  grupo2            String?
  grupo3            String?
  grupo4            String?
  observacion       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  obsBoletin        String?
  materiaPendiente1 String?
  materiaPendiente2 String?
  mp1m1             String?
  mp1m2             String?
  mp1m3             String?
  mp1m4             String?
  mp2m1             String?
  mp2m2             String?
  mp2m3             String?
  mp2m4             String?
  pl1               String?
  pl2               String?
  pl3               String?
  pl4               String?
  pl5               String?
  scoreAP           String?
  scoreCA           String?
  scoreCN           String?
  scoreEF           String?
  scoreGHC          String?
  scoreILE          String?
  scoreMA           String?
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, anioEscolar, grado, seccion])
  @@index([anioEscolar, grado, seccion])
}

model CertLayout {
  id        String   @id @default(cuid())
  nombre    String
  datos     String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
}

model DashboardState {
  id        String   @id @default(cuid())
  plan      String   @unique
  datos     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CentroEscolar {
  id        String   @id @default(cuid())
  codigo    String   @default("")
  nombre    String   @unique
  localidad String   @default("")
  ef        String   @default("")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([codigo])
  @@index([nombre])
  @@index([ef])
}

model PlanVigente {
  id              String   @id @default(cuid())
  cedula          String   @unique
  fechaNacimiento String?
  apellidos       String
  nombres         String
  pais            String   @default("VENEZUELA")
  estado          String   @default("")
  municipio       String   @default("")
  rawData         String   @default("{}")
  certDraft       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cedula])
  @@index([apellidos])
  @@index([nombres])
}

model PlanDerogado {
  id              String   @id @default(cuid())
  cedula          String   @unique
  fechaNacimiento String?
  apellidos       String
  nombres         String
  pais            String   @default("VENEZUELA")
  estado          String   @default("")
  municipio       String   @default("")
  rawData         String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  certDraft       String?

  @@index([cedula])
  @@index([apellidos])
  @@index([nombres])
}

model anoEscolar {
  id        String   @id @default(cuid())
  nombre    String   @unique // "2021 - 2022"
  activo    Boolean  @default(false) // solo uno activo
  abierto   Boolean  @default(true)
  createdAt DateTime @default(now())
  secciones seccion[]
  inscripciones inscripcion[]
}

model asignatura {
  id          String           @id @default(cuid())
  codigo      String           @unique // CA, ILE, MA...
  nombre      String // Castellano, Matematicas...
  orden       Int              @default(0)
  docenteSecc docenteSeccion[]
}

model docente {
  id          String           @id @default(cuid())
  cedula      String           @unique // "V 9203310"
  nombre      String // "OLIVEROS, ARAMIS"
  docenteSecc docenteSeccion[]
}

model seccion {
  id           String           @id @default(cuid())
  anoEscolarId String
  grado        String // "1".."5"
  codigo       String // "A".."I", "MP"
  tipo         String           @default("REGULAR") // REGULAR | MP
  ano          anoEscolar       @relation(fields: [anoEscolarId], references: [id])
  docenteSecc  docenteSeccion[]
  inscripciones inscripcion[]

  @@unique([anoEscolarId, grado, codigo])
}

model docenteSeccion {
  id           String      @id @default(cuid())
  seccionId    String
  asignaturaId String
  docenteId    String?
  seccion      seccion     @relation(fields: [seccionId], references: [id])
  asignatura   asignatura  @relation(fields: [asignaturaId], references: [id])
  docente      docente?    @relation(fields: [docenteId], references: [id])

  @@unique([seccionId, asignaturaId])
}

model alumno {
  id         String   @id @default(cuid())
  cedula     String   @unique // "V 32787155"
  apellidos  String
  nombres    String
  sexo       String? // M | F
  fechaNac   String? // ISO
  entidad    String? // municipio nacimiento
  ef         String? // estado (sigla)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  inscripciones inscripcion[]

  @@index([apellidos])
  @@index([nombres])
}

model inscripcion {
  id           String    @id @default(cuid())
  alumnoId     String
  seccionId    String
  anoEscolarId String
  matricula    String? // nro de matricula legacy
  repitiente   Boolean   @default(false)
  fechaRetiro  DateTime?
  activo       Boolean   @default(true)
  alumno       alumno      @relation(fields: [alumnoId], references: [id])
  seccion      seccion     @relation(fields: [seccionId], references: [id])
  ano          anoEscolar  @relation(fields: [anoEscolarId], references: [id])

  @@unique([alumnoId, anoEscolarId])
}
