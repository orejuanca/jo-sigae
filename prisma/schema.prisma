generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Student {
  id              String          @id @default(cuid())
  cedula          String          @unique
  fechaNacimiento String?
  apellidos       String
  nombres         String
  pais            String          @default("VENEZUELA")
  estado          String          @default("")
  municipio       String          @default("")
  seccion         String          @default("")
  plan            String          @default("vigente")
  rawData         String          @default("{}")
  certDraft       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  boletaExtras    BoletaExtra[]
  boletaNotas     BoletaNota[]
  certifications  Certification[]

  @@index([cedula])
  @@index([apellidos])
  @@index([nombres])
}

model Certification {
  id           String   @id @default(cuid())
  studentId    String
  tipo         String   @default("certificacion")
  fechaEmision DateTime @default(now())
  datos        String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  numero       String   @default("")
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tipo])
}

model BoletaNota {
  id          String   @id @default(cuid())
  studentId   String
  anioEscolar String
  grado       String
  seccion     String
  materia     String
  lapso1      String?
  lapso2      String?
  lapso3      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revision    String?
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, anioEscolar, grado, seccion, materia])
  @@index([studentId])
  @@index([anioEscolar, grado, seccion])
}

model BoletaExtra {
  id                String   @id @default(cuid())
  studentId         String
  anioEscolar       String
  grado             String
  seccion           String
  grupo1            String?
  grupo2            String?
  grupo3            String?
  grupo4            String?
  observacion       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  obsBoletin        String?
  materiaPendiente1 String?
  materiaPendiente2 String?
  mp1m1             String?
  mp1m2             String?
  mp1m3             String?
  mp1m4             String?
  mp2m1             String?
  mp2m2             String?
  mp2m3             String?
  mp2m4             String?
  pl1               String?
  pl2               String?
  pl3               String?
  pl4               String?
  pl5               String?
  scoreAP           String?
  scoreCA           String?
  scoreCN           String?
  scoreEF           String?
  scoreGHC          String?
  scoreILE          String?
  scoreMA           String?
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, anioEscolar, grado, seccion])
  @@index([anioEscolar, grado, seccion])
}

model CertLayout {
  id        String   @id @default(cuid())
  nombre    String
  datos     String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
}

model DashboardState {
  id        String   @id @default(cuid())
  plan      String   @unique
  datos     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CentroEscolar {
  id        String   @id @default(cuid())
  codigo    String   @default("")
  nombre    String   @unique
  localidad String   @default("")
  ef        String   @default("")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([codigo])
  @@index([nombre])
  @@index([ef])
}

model PlanVigente {
  id              String   @id @default(cuid())
  cedula          String   @unique
  fechaNacimiento String?
  apellidos       String
  nombres         String
  pais            String   @default("VENEZUELA")
  estado          String   @default("")
  municipio       String   @default("")
  rawData         String   @default("{}")
  certDraft       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cedula])
  @@index([apellidos])
  @@index([nombres])
}

model PlanDerogado {
  id              String   @id @default(cuid())
  cedula          String   @unique
  fechaNacimiento String?
  apellidos       String
  nombres         String
  pais            String   @default("VENEZUELA")
  estado          String   @default("")
  municipio       String   @default("")
  rawData         String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  certDraft       String?

  @@index([cedula])
  @@index([apellidos])
  @@index([nombres])
}

model anoEscolar {
  id        String   @id @default(cuid())
  nombre    String   @unique // "2021 - 2022"
  activo    Boolean  @default(false) // solo uno activo
  abierto   Boolean  @default(true)
  createdAt DateTime @default(now())
  secciones seccion[]
  inscripciones inscripcion[]
}

model asignatura {
  id          String           @id @default(cuid())
  codigo      String           @unique // CA, ILE, MA...
  nombre      String // Castellano, Matematicas...
  orden       Int              @default(0)
  docenteSecc docenteSeccion[]
  notaLapsos  notaLapso[]
  notaMomentos notaMomento[]
  notaRevisiones notaRevision[]
}

model docente {
  id          String           @id @default(cuid())
  cedula      String           @unique // "V 9203310"
  nombre      String // "OLIVEROS, ARAMIS"
  docenteSecc docenteSeccion[]
}

model seccion {
  id           String           @id @default(cuid())
  anoEscolarId String
  grado        String // "1".."5"
  codigo       String // "A".."I", "MP"
  tipo         String           @default("REGULAR") // REGULAR | MP
  ano          anoEscolar       @relation(fields: [anoEscolarId], references: [id])
  docenteSecc  docenteSeccion[]
  inscripciones inscripcion[]

  @@unique([anoEscolarId, grado, codigo])
}

model docenteSeccion {
  id           String      @id @default(cuid())
  seccionId    String
  asignaturaId String
  docenteId    String?
  seccion      seccion     @relation(fields: [seccionId], references: [id])
  asignatura   asignatura  @relation(fields: [asignaturaId], references: [id])
  docente      docente?    @relation(fields: [docenteId], references: [id])

  @@unique([seccionId, asignaturaId])
}

model alumno {
  id             String   @id @default(cuid())
  cedula         String   @unique // "V 32787155"
  apellidos      String
  nombres        String
  sexo           String? // M | F
  fechaNac       String? // ISO
  entidad        String? // municipio nacimiento
  ef             String? // estado (sigla)
  // ---- Sabana de alumnos INTEGRA (Bloque 1) ----
  cedulaEscolar  String? // col 23: cedula escolar (V10917790806)
  estado         String? // col 14: estado (nombre completo: ARAGUA...)
  pais           String? // col 17
  localidad      String? // col 18
  direccion      String? // col 28
  telefono       String? // col 35
  correo         String? // col 42
  serial         String? // col 19: serial de la cedula
  te             String? // col 20: campo TE de la sabana (F/NO)
  obsHr          String? // col 21: observaciones HR (titulos)
  repCedula      String? // col 24: cedula del representante
  repNombre      String? // col 25
  repApellido    String? // col 26
  repAfinidad    String? // col 27: MADRE/PADRE...
  plantelProc1   String? // col 29: plantel de procedencia 1
  plantelProc2   String? // col 37
  plantelProc3   String? // col 38
  plantelProc4   String? // col 39
  plantelProc5   String? // col 40
  obsGenerales   String? // col 41: observaciones generales
  eqv            String? // col 43: EQV
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  inscripciones  inscripcion[]

  @@index([apellidos])
  @@index([nombres])
  @@index([cedulaEscolar])
}

model inscripcion {
  id           String    @id @default(cuid())
  alumnoId     String
  seccionId    String
  anoEscolarId String
  matricula    String? // nro de matricula legacy
  repitiente   Boolean   @default(false)
  materiaPend1 String? // materia pendiente 1 (código asignatura, ej: MA) — solo inscripciones en sección MP
  materiaPend2 String? // materia pendiente 2 (código asignatura)
  numeroLista   String? // N- de la sabana (col 5)
  condicion     String? // col 31: REGULAR | REPITE | REGULAR MP
  sp            String? // col 32: campo SP de la sabana (U)
  ingEgr        String? // col 36: INGRESO x LAPSO
  obsBoletin    String? // col 30: observaciones boletin (por ano)
  fechaRetiro  DateTime?
  activo       Boolean   @default(true)
  alumno       alumno      @relation(fields: [alumnoId], references: [id])
  seccion      seccion     @relation(fields: [seccionId], references: [id])
  ano          anoEscolar  @relation(fields: [anoEscolarId], references: [id])
  notaLapsos   notaLapso[]
  notaMomentos notaMomento[]
  notaGrupos   notaGrupo[]
  notaRevisiones notaRevision[]

  @@unique([alumnoId, seccionId]) // un alumno no repite sección, pero SÍ puede estar en su regular + MP
  @@index([alumnoId, anoEscolarId])
}

// ==================== NOTAS (Bloque 2) ====================

// Nota de LAPSO de una asignatura para una inscripción (secciones regulares).
// SOLO los 3 lapsos se guardan; la definitiva es promedio calculado (nunca se guarda).
model notaLapso {
  id            String      @id @default(cuid())
  inscripcionId String
  asignaturaId  String
  lapso         Int         // 1 | 2 | 3
  valor         String?     // "15.5" (1-20, 1 decimal) | cualitativa (A/B/C/D/EX) | null = pendiente
  updatedAt     DateTime    @updatedAt
  inscripcion   inscripcion @relation(fields: [inscripcionId], references: [id])
  asignatura    asignatura  @relation(fields: [asignaturaId], references: [id])

  @@unique([inscripcionId, asignaturaId, lapso])
  @@index([asignaturaId])
}

// GRUPO: columna cualitativa del Excel (GRUPO11..GRUPO14 en las hojas NL).
// En secciones regulares se guarda por lapso (1-3) como OC/PG.
// En secciones MP se guarda un valor único por estudiante (lapso 4),
// porque el bloque U del Excel trae la columna GRUPO sin división útil.
// Valor real usado en 2021-2022: "EXONERADO".
model notaGrupo {
  id            String      @id @default(cuid())
  inscripcionId String
  lapso         Int         // 1 | 2 | 3 (regular) | 4 (valor único en MP)
  valor         String?     // "EXONERADO" | null = pendiente
  updatedAt     DateTime    @updatedAt
  inscripcion   inscripcion @relation(fields: [inscripcionId], references: [id])

  @@unique([inscripcionId, lapso])
}

// Nota de MOMENTO de una materia pendiente (secciones MP).
// 4 momentos ÚNICOS E INDEPENDIENTES según la sábana PROFESORES:
//   1M = OCTUBRE, 2M = DICIEMBRE, 3M = ENERO, 4M = JUNIO.
// Regla de la escuela: al aprobar (nota >= 10) en cualquier momento, la materia
// queda aprobada y los momentos siguientes se ANULAN con "*" (derivado, no se guarda).
// Aplazado en 4M -> queda MP para el próximo año (P en todas las asignaturas de su
// sección regular y sin derecho a revisión; se aplica en el cierre del año escolar).
model notaMomento {
  id            String      @id @default(cuid())
  inscripcionId String      // la inscripción en la sección MP (grado anterior)
  asignaturaId  String      // la materia que debe (asignatura del grado anterior)
  momento       Int         // 1 | 2 | 3 | 4
  valor         String?     // "12" (>=10, aprobó) | "IN" (insuficiente) | null = sin asentar
  updatedAt     DateTime    @updatedAt
  inscripcion   inscripcion @relation(fields: [inscripcionId], references: [id])
  asignatura    asignatura  @relation(fields: [asignaturaId], references: [id])

  @@unique([inscripcionId, asignaturaId, momento])
  @@index([asignaturaId])
}

// ==================== REVISIÓN (hojas NR del Excel) ====================

// Resultado de la REVISIÓN de la definitiva de una asignatura NUMÉRICA de
// sección regular (hojas "NR 1°".."NR 5°" del Excel). Va a revisión quien NO
// aprobó todas las materias: definitiva numérica < 10 (mismo criterio que el
// Excel; P y las materias sin definitiva no llevan revisión).
// El Excel NR trae por celda: "IN" (insuficiente, sigue aplazado) o un ENTERO
// (resultado tras la revisión: 10, 11, 12, 13, 16... también hay "2").
// Lo aprobado sin revisión se muestra con "*" derivado (nunca se guarda).
// Las cualitativas (OC/PGCRP/GRUPO) NO llevan revisión: en el Excel NR
// siempre están con "*" (verificado en los 5 grados).
model notaRevision {
  id            String      @id @default(cuid())
  inscripcionId String
  asignaturaId  String
  valor         String      // "IN" | entero 1-20 (resultado de la revisión)
  updatedAt     DateTime    @updatedAt
  inscripcion   inscripcion @relation(fields: [inscripcionId], references: [id])
  asignatura    asignatura  @relation(fields: [asignaturaId], references: [id])

  @@unique([inscripcionId, asignaturaId])
  @@index([asignaturaId])
}
