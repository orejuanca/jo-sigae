+      const e = porAlumno.get(a.id);
+      return {
+        ...a,
+        inscritoEn: e ? e.etiquetas.join(' + ') : null,
+        inscritoRegularEn: e?.regular ?? null,
+        inscritoEnLista: e?.etiquetas ?? [],
+      };
+    }),
   });
 }
