+            </div>
+            <div className="max-h-40 overflow-y-auto text-xs text-gray-600">
+              {docentes.map(d => <div key={d.id} className="border-b py-1"><b className="text-gray-800">{d.cedula}</b> · {d.nombre}</div>)}
+            </div>
+          </div>
+        </section>
